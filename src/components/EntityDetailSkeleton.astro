---
interface Props {
  isSede?: boolean;
}
const { isSede = false } = Astro.props;
---

<div class="min-h-screen bg-[#09090B] pb-16 animate-pulse">
  <!-- Top Navbar Skeleton -->
  <div class="fixed top-3 inset-x-0 z-50 w-full px-3 md:px-5">
    <div
      class="w-full rounded-2xl px-4 md:px-8 py-3.5 flex items-center justify-between gap-4 border border-white/15"
      style="background: rgba(24, 24, 30, 0.72); backdrop-filter: blur(18px);"
    >
      <div class="h-8 w-28 sm:w-36 rounded-full bg-white/10"></div>
      <div class="hidden md:block h-6 w-56 rounded-full bg-white/10"></div>
      <div class="flex items-center gap-3">
        <div class="h-6 w-20 rounded-full bg-white/10"></div>
        <div class="h-9 w-28 sm:w-36 rounded-full bg-white/15"></div>
      </div>
    </div>
  </div>

  <main class="mx-auto w-full max-w-[1400px] px-4 md:px-6 pt-30 sm:pt-26 md:pt-24">
    {
      isSede && (
        <div class="mx-auto max-w-[1260px] flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-6">
          <div class="space-y-3">
            <div class="h-10 sm:h-12 w-64 rounded-2xl bg-white/10"></div>
            <div class="h-5 w-80 max-w-full rounded-full bg-white/5"></div>
          </div>
          <div class="h-28 w-full max-w-[390px] rounded-[22px] bg-white/5 border border-white/10"></div>
        </div>
      )
    }

    <!-- 360° Viewport Skeleton -->
    <div
      class={`w-full ${
        isSede
          ? 'h-[260px] sm:h-[310px] md:h-[340px]'
          : 'h-[300px] sm:h-[420px] md:h-[520px] xl:h-[580px]'
      } rounded-[24px] border border-[#27272A] bg-[#121216] flex flex-col items-center justify-center gap-3`}
    >
      <div class="w-10 h-10 rounded-full border-2 border-pink-500/40 border-t-pink-500 animate-spin"></div>
      <div class="h-3.5 w-40 rounded-full bg-white/10"></div>
    </div>

    <!-- Thumbnail Strip Skeleton -->
    <div class="mt-4 flex items-center gap-2 sm:gap-3 max-w-[1260px] mx-auto overflow-hidden">
      <div class="shrink-0 w-[calc((100%-16px)/3)] sm:w-[calc((100%-36px)/4)] md:w-[calc((100%-60px)/6)] h-14 sm:h-20 md:h-24 rounded-xl sm:rounded-2xl bg-white/5 border border-white/10"></div>
      <div class="shrink-0 w-[calc((100%-16px)/3)] sm:w-[calc((100%-36px)/4)] md:w-[calc((100%-60px)/6)] h-14 sm:h-20 md:h-24 rounded-xl sm:rounded-2xl bg-white/5 border border-white/10"></div>
      <div class="shrink-0 w-[calc((100%-16px)/3)] sm:w-[calc((100%-36px)/4)] md:w-[calc((100%-60px)/6)] h-14 sm:h-20 md:h-24 rounded-xl sm:rounded-2xl bg-white/5 border border-white/10"></div>
      <div class="hidden sm:block shrink-0 w-[calc((100%-36px)/4)] md:w-[calc((100%-60px)/6)] h-20 md:h-24 rounded-2xl bg-white/5 border border-white/10"></div>
    </div>

    <!-- Bottom Split Skeleton -->
    <div class="mt-8 mx-auto max-w-[1260px] grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 space-y-3">
        <div class="h-8 sm:h-10 w-72 max-w-full rounded-2xl bg-white/10"></div>
        <div class="h-4 w-44 rounded-full bg-white/5"></div>
        <div class="pt-2 space-y-2.5">
          <div class="h-4 w-3/4 rounded-full bg-white/5"></div>
          <div class="h-4 w-2/3 rounded-full bg-white/5"></div>
          <div class="h-4 w-1/2 rounded-full bg-white/5"></div>
        </div>
      </div>
      <div class="lg:col-span-5 flex lg:justify-end">
        <div class="w-full max-w-[390px] h-44 rounded-[22px] bg-white/5 border border-white/10"></div>
      </div>
    </div>
  </main>
</div>
