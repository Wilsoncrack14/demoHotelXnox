---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import PanoramaViewer360 from '../../components/PanoramaViewer360';
import LocationBookingCard from '../../components/LocationBookingCard';
import { SEDES, ROOMS, type SedeItem, type Scene360 } from '../../data/hotelData';

export function getStaticPaths() {
  return SEDES.map((sede) => ({
    params: { slug: sede.slug },
    props: { sede },
  }));
}

interface Props {
  sede: SedeItem;
}

const { sede } = Astro.props;
const sedeRooms = ROOMS.filter((r) => sede.roomSlugs.includes(r.slug));

const sedeInitialScenes: Scene360[] = [
  {
    id: `sede-${sede.slug}-1`,
    title: 'Ingreso & Recepción 360°',
    isPrimary: true,
    fileSizeWebP: '1.3 MB WebP',
    panoramaUrl: sede.panoramaUrl,
    thumbUrl: '/images/thumb-ingreso.webp',
    hotspots: sede.hotspots,
  },
];
---

<Layout
  title={`${sede.name} — Habitaciones y Tour 360° | Hotel Xnox`}
  defaultSede={sede.name}
  defaultItem={`Suite Neón Jacuzzi (${sede.name})`}
  defaultPrice="S/ 180 (4 Horas)"
>
  <div class="min-h-screen bg-[#09090B] pb-16">
    <!-- Top Navbar with "← Volver a sedes" matching detalle sede.jpg -->
    <div class="pt-3">
      <Navbar
        client:load
        variant="sede-detail"
        activeNav="sedes"
        backHref="/sedes"
        backLabel="Volver a sedes"
        whatsappSede={sede.name}
        whatsappItem="Suite Neón Jacuzzi"
        whatsappPrice="S/ 180 (4 Horas)"
      />
    </div>

    <main class="mx-auto w-full max-w-[1400px] px-4 md:px-6 pt-24 md:pt-26">
      <!-- Editorial Header + Right Glassmorphism Location/Booking Card -->
      <div class="mx-auto max-w-[1260px] flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-6">
        <div>
          <h1 class="text-4xl sm:text-5xl md:text-[54px] font-normal tracking-tight text-[#FAFAFA] leading-none">
            {sede.name}
          </h1>
          <p class="mt-3 text-base md:text-[19px] text-[#A1A1AA]">
            {sede.tagline}
          </p>
          <p class="mt-2.5 text-sm md:text-base text-[#E4E4E7]">
            {sede.scheduleInfo}
          </p>
        </div>

        <div class="flex lg:justify-end">
          <LocationBookingCard
            client:load
            compact={true}
            primaryTitle={sede.address}
            googleMapsUrl={sede.googleMapsUrl}
            wazeUrl={sede.wazeUrl}
            whatsappSede={sede.name}
            whatsappItem="Suite Neón Jacuzzi"
            whatsappPrice="S/ 180 (4 Horas)"
          />
        </div>
      </div>

      <!-- Widescreen 360° Sede Viewport matching detalle sede.jpg -->
      <PanoramaViewer360
        client:load
        entityKey={`sedes:${sede.slug}`}
        initialScenes={sedeInitialScenes}
        showThumbnails={false}
        heightClass="h-[260px] sm:h-[310px] md:h-[340px]"
      />

      <!-- Habitaciones en Sede Grid -->
      <section class="mx-auto max-w-[1260px] mt-8">
        <h2 class="text-xl sm:text-2xl md:text-[26px] font-normal text-[#FAFAFA] mb-4">
          Habitaciones en {sede.name}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            sedeRooms.map((room) => (
              <a
                href={`/habitaciones/${room.slug}`}
                class="group relative h-[230px] sm:h-[245px] rounded-[24px] overflow-hidden bento-card flex flex-col justify-end p-5"
              >
                <img
                  src={room.cardImage}
                  alt={room.title}
                  class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                />
                <div
                  class="absolute inset-0"
                  style="background: linear-gradient(180deg, rgba(9,9,11,0.05) 0%, rgba(9,9,11,0.22) 52%, rgba(9,9,11,0.92) 100%);"
                />

                <div class="relative z-10 flex items-end justify-between gap-3">
                  <div>
                    <h3 class="text-xl md:text-[22px] font-medium text-[#FAFAFA] leading-snug">
                      {room.title}
                    </h3>
                    <p class="mt-0.5 text-xs md:text-sm text-[#D4D4D8]">
                      {room.priceText} ({room.durationText}) • Visor 360°
                    </p>
                  </div>

                  <span class="w-8 h-8 rounded-full bg-white text-[#09090B] flex items-center justify-center shrink-0 group-hover:translate-x-1 transition-transform font-bold text-sm shadow-md">
                    →
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Layout>
