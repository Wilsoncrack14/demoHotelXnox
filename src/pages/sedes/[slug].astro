---
import Layout from '../../layouts/Layout.astro';
import PublicEntityDetail from '../../components/PublicEntityDetail';
import EntityDetailSkeleton from '../../components/EntityDetailSkeleton.astro';
import { SEDES, type SedeItem } from '../../data/hotelData';

export function getStaticPaths() {
  return SEDES.map((sede) => ({
    params: { slug: sede.slug },
    props: { sede },
  }));
}

interface Props {
  sede: SedeItem;
}

const { sede } = Astro.props;
---

<Layout
  title={`${sede.name} — Habitaciones y Tour 360° | Hotel Xnox`}
  defaultSede={sede.name}
  defaultItem={`Suite Neón Jacuzzi (${sede.name})`}
  defaultPrice="S/ 180 (4 Horas)"
>
  <PublicEntityDetail client:only="react" initialCategory="sedes" initialSlug={sede.slug}>
    <EntityDetailSkeleton slot="fallback" isSede={true} />
  </PublicEntityDetail>
</Layout>
