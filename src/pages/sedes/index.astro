---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import { SEDES } from '../../data/hotelData';
---

<Layout title="5 Sedes Exclusivas en Lima | Hotel Xnox 360°">
  <div class="min-h-screen bg-[#09090B] pb-20">
    <div class="pt-3">
      <Navbar client:load activeNav="sedes" />
    </div>

    <main class="mx-auto w-full max-w-[1260px] px-4 md:px-6 pt-24 md:pt-28">
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl md:text-[44px] font-light uppercase tracking-[-0.01em] text-[#FAFAFA]">
          5 SEDES EXCLUSIVAS EN LIMA
        </h1>
        <p class="mt-1.5 text-sm md:text-base text-[#A1A1AA]">
          Atención las 24 horas, estacionamiento privado automatizado y suites temáticas en 360°.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          SEDES.map((sede) => (
            <a
              href={`/sedes/${sede.slug}`}
              class="group relative h-[280px] rounded-[24px] overflow-hidden bento-card flex flex-col justify-between p-6"
            >
              <img
                src="/images/bento-sedes.webp"
                alt={sede.name}
                class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(180deg, rgba(9,9,11,0.2) 0%, rgba(9,9,11,0.35) 45%, rgba(9,9,11,0.94) 100%);"
              />

              <div class="relative z-10 flex justify-between items-center">
                <span class="glass-hotspot px-3.5 py-1 rounded-full text-xs text-white font-medium">
                  Abierto 24 Horas
                </span>
                <span class="glass-hotspot px-3 py-1 rounded-full text-xs text-pink-400 font-medium">
                  Tour 360°
                </span>
              </div>

              <div class="relative z-10">
                <h2 class="text-2xl font-medium text-[#FAFAFA]">{sede.name}</h2>
                <p class="mt-1 text-xs md:text-sm text-[#D4D4D8]">{sede.address}</p>
                <div class="mt-3 flex items-center justify-between text-xs text-[#A1A1AA]">
                  <span>Cochera Privada • Suites Jacuzzi</span>
                  <span class="text-white font-medium group-hover:translate-x-1 transition-transform">
                    Explorar Sede →
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </main>
  </div>
</Layout>
