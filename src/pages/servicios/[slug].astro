---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import PanoramaViewer360 from '../../components/PanoramaViewer360';
import LocationBookingCard from '../../components/LocationBookingCard';
import { SERVICES, type ServiceItem } from '../../data/hotelData';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
---

<Layout
  title={`${service.title} — Servicios 360° | Hotel Xnox`}
  defaultSede="Sede Surco"
  defaultItem={service.title}
  defaultPrice={service.topBarPriceText}
>
  <div class="min-h-screen bg-[#09090B] pb-16">
    <!-- Top Contextual Bar matching detalle servicio.jpg -->
    <div class="pt-3">
      <Navbar
        client:load
        variant="entity-detail"
        backHref="/servicios"
        backLabel="Volver a servicios"
        detailTitle={service.title}
        priceLabel={service.topBarPriceText}
        whatsappSede="Sede Surco"
        whatsappItem={service.title}
        whatsappPrice={service.topBarPriceText}
      />
    </div>

    <main class="mx-auto w-full max-w-[1400px] px-4 md:px-6 pt-22 md:pt-24">
      <!-- 360° Viewport & Thumbnail Carousel -->
      <PanoramaViewer360
        client:load
        entityKey={`servicios:${service.slug}`}
        initialScenes={service.scenes}
        showThumbnails={true}
        showCarouselArrows={false}
      />

      <!-- Bottom Split: Equipamiento (Left) + Glassmorphism Booking Card (Right) -->
      <div class="mt-8 mx-auto max-w-[1260px] grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7">
          <h2 class="text-2xl sm:text-3xl md:text-[36px] font-normal tracking-tight text-[#FAFAFA]">
            {service.title}
          </h2>
          <p class="mt-2 text-sm md:text-base text-[#A1A1AA]">
            {service.amenitiesTitle}
          </p>

          <ul class="mt-3 space-y-2.5 text-sm sm:text-base md:text-[17px] text-[#D4D4D8]">
            {
              service.amenities.map((item) => (
                <li class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-white shrink-0" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:col-span-5 flex lg:justify-end">
          <LocationBookingCard
            client:load
            primaryTitle={service.availabilityTitle}
            secondarySubtitle={service.address}
            whatsappSede="Sede Surco"
            whatsappItem={service.title}
            whatsappPrice={service.topBarPriceText}
          />
        </div>
      </div>
    </main>
  </div>
</Layout>
