---
import Layout from '../../layouts/Layout.astro';
import PublicEntityDetail from '../../components/PublicEntityDetail';
import EntityDetailSkeleton from '../../components/EntityDetailSkeleton.astro';
import { SERVICES, type ServiceItem } from '../../data/hotelData';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
---

<Layout
  title={`${service.title} — Servicios 360° | Hotel Xnox`}
  defaultSede="Sede Surco"
  defaultItem={service.title}
  defaultPrice={service.topBarPriceText}
>
  <PublicEntityDetail client:only="react" initialCategory="servicios" initialSlug={service.slug}>
    <EntityDetailSkeleton slot="fallback" />
  </PublicEntityDetail>
</Layout>
