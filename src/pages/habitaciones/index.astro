---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import RoomsCatalogGrid from '../../components/RoomsCatalogGrid';
---

<Layout title="Habitaciones 360° — Catálogo de Suites | Hotel Xnox">
  <div class="min-h-screen bg-[#09090B] pb-20">
    <div class="pt-3">
      <Navbar client:load activeNav="habitaciones" />
    </div>

    <main class="mx-auto w-full max-w-[1440px] px-4 md:px-8 xl:px-10 pt-22 sm:pt-24 md:pt-28">
      <div class="mb-5 sm:mb-6 pb-5 border-b border-white/10">
        <span class="inline-block mb-2 text-[11px] uppercase tracking-[0.22em] text-[#A1A1AA]">
          Catálogo Completo • 5 Sedes en Lima
        </span>
        <h1 class="text-2xl sm:text-4xl md:text-[46px] font-light uppercase tracking-[-0.015em] text-[#FAFAFA] leading-none">
          HABITACIONES 360°
        </h1>
        <p class="mt-2 text-xs sm:text-sm md:text-base text-[#A1A1AA] max-w-xl">
          Explora nuestras suites temáticas con recorrido virtual interactivo en 360°.
        </p>
      </div>

      <RoomsCatalogGrid client:load showSedeFilter={true} />
    </main>
  </div>
</Layout>
