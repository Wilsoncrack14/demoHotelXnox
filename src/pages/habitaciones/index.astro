---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import { ROOMS, SEDES } from '../../data/hotelData';
---

<Layout title="Habitaciones 360° — Catálogo de Suites | Hotel Xnox">
  <div class="min-h-screen bg-[#09090B] pb-20">
    <div class="pt-3">
      <Navbar client:load activeNav="habitaciones" />
    </div>

    <main class="mx-auto w-full max-w-[1260px] px-4 md:px-6 pt-24 md:pt-28">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl sm:text-4xl md:text-[44px] font-light uppercase tracking-[-0.01em] text-[#FAFAFA]">
            HABITACIONES 360°
          </h1>
          <p class="mt-1.5 text-sm md:text-base text-[#A1A1AA]">
            Explora nuestras suites temáticas con recorrido virtual interactivo en 360°.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {
            SEDES.map((s) => (
              <a
                href={`/sedes/${s.slug}`}
                class="px-3.5 py-1.5 rounded-full text-xs md:text-sm bg-[#18181D] border border-white/15 text-[#D4D4D8] hover:text-white hover:border-white/40 transition-all"
              >
                {s.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          ROOMS.map((room) => (
            <a
              href={`/habitaciones/${room.slug}`}
              class="group relative h-[270px] rounded-[24px] overflow-hidden bento-card flex flex-col justify-end p-6"
            >
              <img
                src={room.cardImage}
                alt={room.title}
                class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(180deg, rgba(9,9,11,0.05) 0%, rgba(9,9,11,0.25) 50%, rgba(9,9,11,0.92) 100%);"
              />

              <div class="relative z-10 flex items-end justify-between gap-3">
                <div>
                  <h2 class="text-xl md:text-[23px] font-medium text-[#FAFAFA] leading-snug">
                    {room.title}
                  </h2>
                  <p class="mt-0.5 text-xs md:text-sm text-[#D4D4D8]">
                    {room.priceText} ({room.durationText}) • Visor 360°
                  </p>
                </div>

                <span class="w-8 h-8 rounded-full bg-white text-[#09090B] flex items-center justify-center shrink-0 group-hover:translate-x-1 transition-transform font-bold text-sm">
                  →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </main>
  </div>
</Layout>
