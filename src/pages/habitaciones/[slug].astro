---
import Layout from '../../layouts/Layout.astro';
import PublicEntityDetail from '../../components/PublicEntityDetail';
import EntityDetailSkeleton from '../../components/EntityDetailSkeleton.astro';
import { ROOMS, type RoomItem } from '../../data/hotelData';

export function getStaticPaths() {
  return ROOMS.map((room) => ({
    params: { slug: room.slug },
    props: { room },
  }));
}

interface Props {
  room: RoomItem;
}

const { room } = Astro.props;
const fullPriceLabel = `${room.priceText} (${room.durationText})`;
---

<Layout
  title={`${room.title} — ${room.sedeName} | Tour 360° Hotel Xnox`}
  defaultSede={room.sedeName}
  defaultItem={room.title}
  defaultPrice={fullPriceLabel}
>
  <PublicEntityDetail client:only="react" initialCategory="habitaciones" initialSlug={room.slug}>
    <EntityDetailSkeleton slot="fallback" />
  </PublicEntityDetail>
</Layout>
