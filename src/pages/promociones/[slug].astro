---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import TourViewer360 from '../../components/TourViewer360';
import LocationBookingCard from '../../components/LocationBookingCard';
import { PROMOTIONS, type PromoItem } from '../../data/hotelData';

export function getStaticPaths() {
  return PROMOTIONS.map((promo) => ({
    params: { slug: promo.slug },
    props: { promo },
  }));
}

interface Props {
  promo: PromoItem;
}

const { promo } = Astro.props;
---

<Layout
  title={`${promo.title} — Promoción Especial 360° | Hotel Xnox`}
  defaultSede="Sede Surco"
  defaultItem={`Promo: ${promo.title}`}
  defaultPrice={promo.promoPrice}
>
  <div class="min-h-screen bg-[#09090B] pb-16">
    <!-- Top Contextual Bar matching detalle promociones.jpg -->
    <div class="pt-3">
      <Navbar
        client:load
        variant="entity-detail"
        backHref="/promociones"
        backLabel="Volver a promociones"
        detailTitle={promo.detailHeaderTitle}
        priceLabel={promo.promoPrice}
        oldPriceLabel={`Antes ${promo.oldPrice}`}
        whatsappSede="Sede Surco"
        whatsappItem={`Promo: ${promo.title}`}
        whatsappPrice={promo.promoPrice}
      />
    </div>

    <main class="mx-auto w-full max-w-[1400px] px-4 md:px-6 pt-22 md:pt-24">
      <!-- 360° Viewport & Thumbnail Carousel with Arrows -->
      <TourViewer360
        client:only="react"
        entityKey={`promociones:${promo.slug}`}
        entidadTipo="servicio"
        entidadId={promo.id}
        initialScenes={promo.scenes}
        showThumbnails={true}
        showCarouselArrows={true}
      />

      <!-- Bottom Split: "Que incluye:" (Left) + Glassmorphism Booking Card (Right) -->
      <div class="mt-8 mx-auto max-w-[1260px] grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7">
          <h2 class="text-2xl sm:text-3xl md:text-[36px] font-normal tracking-tight text-[#FAFAFA]">
            {promo.title}
          </h2>
          <p class="mt-2 text-sm md:text-base text-[#A1A1AA]">
            Que incluye:
          </p>

          <ul class="mt-3 space-y-2.5 text-sm sm:text-base md:text-[17px] text-[#D4D4D8]">
            {
              promo.includesList.map((item) => (
                <li class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-white shrink-0" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:col-span-5 flex lg:justify-end">
          <LocationBookingCard
            client:load
            primaryTitle={promo.availabilityTitle}
            secondarySubtitle={`Válido hasta: ${promo.validUntil}`}
            whatsappSede="Sede Surco"
            whatsappItem={`Promo: ${promo.title}`}
            whatsappPrice={promo.promoPrice}
          />
        </div>
      </div>
    </main>
  </div>
</Layout>
