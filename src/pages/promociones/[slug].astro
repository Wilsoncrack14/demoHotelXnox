---
import Layout from '../../layouts/Layout.astro';
import PublicEntityDetail from '../../components/PublicEntityDetail';
import EntityDetailSkeleton from '../../components/EntityDetailSkeleton.astro';
import { PROMOTIONS, type PromoItem } from '../../data/hotelData';

export function getStaticPaths() {
  return PROMOTIONS.map((promo) => ({
    params: { slug: promo.slug },
    props: { promo },
  }));
}

interface Props {
  promo: PromoItem;
}

const { promo } = Astro.props;
---

<Layout
  title={`${promo.title} — Promoción Especial 360° | Hotel Xnox`}
  defaultSede="Sede Surco"
  defaultItem={`Promo: ${promo.title}`}
  defaultPrice={promo.promoPrice}
>
  <PublicEntityDetail client:only="react" initialCategory="promociones" initialSlug={promo.slug}>
    <EntityDetailSkeleton slot="fallback" />
  </PublicEntityDetail>
</Layout>
