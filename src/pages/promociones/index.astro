---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import PromotionsCatalog from '../../components/PromotionsCatalog';
---

<Layout
  title="Promociones & Paquetes Especiales | Hotel Xnox"
  defaultSede="Sede Surco"
  defaultItem="Pack Celebración & Rosas"
  defaultPrice="S/ 210"
>
  <div class="min-h-screen bg-[#09090B]">
    <div class="pt-3">
      <Navbar
        client:load
        activeNav="promociones"
        whatsappSede="Sede Surco"
        whatsappItem="Pack Celebración & Rosas"
        whatsappPrice="S/ 210"
      />
    </div>

    <PromotionsCatalog client:load />
  </div>
</Layout>
