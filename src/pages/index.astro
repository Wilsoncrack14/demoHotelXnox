---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import HomeHeroCarousel from '../components/HomeHeroCarousel';
import HomeBentoCards from '../components/HomeBentoCards';
import HomeRoomsShowcase from '../components/HomeRoomsShowcase';
---

<Layout title="HOTEL XNOX — Sensaciones y Privacidad | 5 Sedes en Lima 360°">
  <div class="relative min-h-screen bg-[#09090B] flex flex-col">
    <!-- Floating Glassmorphism Navbar on top of the full-screen Hero -->
    <Navbar client:load activeNav="home" />

    <!-- Full-Screen (100vh) Hero Banner -->
    <HomeHeroCarousel client:load />

    <!-- 3-Column Bento Showcase Grid hydrated from Supabase/R2 -->
    <main class="relative z-20 mx-auto w-full max-w-[1640px] px-6 md:px-12 xl:px-20 pt-6 pb-20 flex-1">
      <HomeBentoCards client:load />
      <HomeRoomsShowcase client:load />
    </main>
  </div>
</Layout>
