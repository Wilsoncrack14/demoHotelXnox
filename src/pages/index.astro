---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import HomeHeroCarousel from '../components/HomeHeroCarousel';

const bentoCards = [
  {
    title: 'Suites Temáticas',
    href: '/habitaciones/suite-neon-jacuzzi',
    image: '/images/bento-suites.webp',
  },
  {
    title: 'Servicios & Juegos',
    href: '/servicios',
    image: '/images/bento-servicios.webp',
  },
  {
    title: '5 Sedes Exclusivas',
    href: '/sedes/surco',
    image: '/images/bento-sedes.webp',
  },
];
---

<Layout title="HOTEL XNOX — Sensaciones y Privacidad | 5 Sedes en Lima 360°">
  <div class="relative min-h-screen bg-[#09090B] flex flex-col">
    <!-- Floating Glassmorphism Navbar on top of the full-screen Hero -->
    <Navbar client:load activeNav="home" />

    <!-- Full-Screen (100vh) Hero Banner -->
    <HomeHeroCarousel client:load />

    <!-- 3-Column Bento Showcase Grid matching home.jpg — Optimized for 27" Desktop -->
    <main class="relative z-20 mx-auto w-full max-w-[1640px] px-6 md:px-12 xl:px-20 pt-6 pb-20 flex-1">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 xl:gap-8">
        {
          bentoCards.map((card) => (
            <a
              href={card.href}
              class="group relative h-[250px] sm:h-[280px] xl:h-[320px] rounded-[26px] overflow-hidden bento-card block"
            >
              <img
                src={card.image}
                alt={card.title}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(180deg, rgba(9,9,11,0.05) 0%, rgba(9,9,11,0.2) 55%, rgba(9,9,11,0.9) 100%);"
              />
              <div class="absolute bottom-6 left-7 right-7 flex items-center justify-between">
                <span class="text-xl md:text-[22px] xl:text-[25px] font-medium text-[#FAFAFA] tracking-tight inline-flex items-center gap-2.5 group-hover:translate-x-1 transition-transform">
                  <span>{card.title}</span>
                  <span class="text-white/90">→</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </main>
  </div>
</Layout>
